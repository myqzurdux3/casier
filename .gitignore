# Secrets — token Spotify, clé de session, jetons d'API, certificats.
secrets/

# Données produites par l'outil.
out/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / Expo
node_modules/
.expo/
*.apk

# Projet natif régénéré par `expo prebuild`.
mobile/android/
mobile/ios/
mobile/dist/
# Autorité propre à chaque déploiement, copiée depuis secrets/.
mobile/assets/ca.crt
# Clé de signature de l'APK — à sauvegarder hors dépôt.
mobile/*.keystore

# Notes de travail locales : elles contiennent des clés d'API et l'adresse
# réelle du serveur. Elles ont déjà fuité une fois dans l'historique — ne
# jamais les suivre.
to-run-before.txt
how-to-build.txt
*.local.sh
