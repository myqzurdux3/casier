[Unit]
Description=spotify-sort — interface web
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=spotify-sort
Group=spotify-sort
WorkingDirectory=/opt/spotify-sort

# Secrets hors de l'unité : `systemctl show` expose les Environment= à tous.
EnvironmentFile=/etc/spotify-sort.env

# ProtectHome=true masque /home, or gunicorn écrit dans $HOME au démarrage
# (serveur de contrôle) : sans ces deux lignes il journalise une erreur de
# permission à chaque lancement. StateDirectory crée le dossier avec le bon
# propriétaire, systemd s'en charge.
StateDirectory=spotify-sort
Environment=HOME=/var/lib/spotify-sort

# BIND vient de l'EnvironmentFile : 127.0.0.1:8000 derrière un proxy,
# 0.0.0.0:8000 pour une exposition directe en TLS.
#
# TLS servi par gunicorn lui-même, sans reverse proxy. Les certificats sont
# produits par deploy/make-certs.sh ; l'app Android n'accepte que cette
# autorité pour cet hôte. Pour un déploiement derrière un proxy qui termine le
# TLS, retirer les deux lignes --certfile/--keyfile et mettre TRUST_PROXY=1.
#
# --workers 1 est obligatoire : les jobs vivent en mémoire dans le processus.
#
# gthread et non le worker sync par défaut. Le worker sync traite une connexion
# à la fois : un client qui ouvre la connexion puis n'envoie rien la bloque, et
# tout le reste s'empile dans le backlog d'accept. Exposé à Internet, ça arrive
# tout seul — les scanners (Censys et consorts) le font plusieurs fois par jour.
# Avec gthread, une connexion en carafe coûte un thread sur 16.
#
# --timeout 300 et non 0. À 0, l'arbitre ne tue jamais un worker figé, donc rien
# ne rattrape le cas ci-dessus. 300 s est très au-dessus de la plus longue
# requête synchrone (la classification d'un titre par Claude, ~60 s au pire) ;
# les tâches longues, elles, tournent dans un thread de fond et rendent la main
# tout de suite, donc elles ne comptent pas dans ce délai.
ExecStart=/opt/spotify-sort/.venv/bin/gunicorn \
    --workers 1 \
    --worker-class gthread \
    --threads 16 \
    --bind ${BIND} \
    --certfile /opt/spotify-sort/secrets/server.crt \
    --keyfile /opt/spotify-sort/secrets/server.key \
    --timeout 300 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --access-logfile - \
    webapp:app

Restart=on-failure
RestartSec=5s

# --- Durcissement ------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_UNIX et AF_NETLINK sont nécessaires : systemd-resolved passe par une socket
# Unix et getaddrinfo par netlink. Sans eux, plus aucune résolution DNS.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Seuls chemins inscriptibles : exports et secrets, tous deux dans le projet.
ReadWritePaths=/opt/spotify-sort/out /opt/spotify-sort/secrets

# ProtectHome=true masque /home entièrement. Si tu installes le projet sous
# /home/... au lieu de /opt, le service ne pourra pas le lire : soit tu le
# déplaces vers /opt, soit tu passes ProtectHome=false.

[Install]
WantedBy=multi-user.target
