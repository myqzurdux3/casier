# Copier vers /etc/spotify-sort.env puis éditer.
# Pas de guillemets autour des valeurs : systemd les prendrait littéralement.

# --- Obligatoire -------------------------------------------------------------

WEB_PASSWORD=remplace-par-une-phrase-de-passe-longue

SPOTIFY_CLIENT_ID=
ANTHROPIC_API_KEY=

# Adresse d'écoute de gunicorn.
#   127.0.0.1:8000  derrière un reverse proxy
#   0.0.0.0:8000    exposition directe sur le réseau
BIND=0.0.0.0:8000

# --- Exposition directe en HTTP ---------------------------------------------

# Sans HTTPS, le cookie de session ne peut pas porter le flag Secure, sinon la
# connexion boucle indéfiniment.
ALLOW_INSECURE=1
HOST=0.0.0.0

# --- Derrière un reverse proxy (Caddy, nginx) --------------------------------
# Décommenter ces deux lignes ET retirer ALLOW_INSECURE ci-dessus.
#
# TRUST_PROXY=1
# BASE_URL=https://sort.mondomaine.fr

# --- OAuth -------------------------------------------------------------------

# BASE_URL + /spotify/callback doit figurer au caractère près dans les
# Redirect URIs de l'app Spotify. Spotify n'accepte que du HTTPS, sauf une
# adresse de bouclage littérale. Une IP publique en HTTP est donc refusée :
# copie secrets/token.json depuis ta machine plutôt que d'autoriser ici.
BASE_URL=http://127.0.0.1:8000

# --- Clé de session ----------------------------------------------------------

# Sinon générée dans secrets/secret. La fixer évite de déconnecter tout le monde
# si ce fichier disparaît.   openssl rand -hex 32
FLASK_SECRET_KEY=
