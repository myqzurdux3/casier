# Copier vers /etc/spotify-sort.env puis éditer.
# Pas de guillemets autour des valeurs : systemd les prendrait littéralement.

# --- Obligatoire -------------------------------------------------------------

WEB_PASSWORD=remplace-par-une-phrase-de-passe-longue

SPOTIFY_CLIENT_ID=
ANTHROPIC_API_KEY=

# Adresse d'écoute de gunicorn.
#   0.0.0.0:8000    exposition directe en TLS (cas de l'app Android)
#   127.0.0.1:8000  derrière un reverse proxy qui termine le TLS
BIND=0.0.0.0:8000

# --- Exposition directe en TLS (app Android) ---------------------------------

# Certificats produits par deploy/make-certs.sh, servis directement par
# gunicorn (voir ExecStart dans spotify-sort.service). L'app n'accepte que
# cette autorité pour cet hôte.
#
# BASE_URL sert au callback OAuth : cette URL exacte, suffixée de
# /spotify/callback, doit figurer dans les Redirect URIs de l'app Spotify.
# Le certificat étant auto-signé, le navigateur affichera un avertissement à
# accepter une fois lors de la connexion Spotify. Spotify ne vérifie pas le
# certificat : il exige seulement une URL en https://.
BASE_URL=https://192.0.2.10:8000

# --- Derrière un reverse proxy (Caddy, nginx) --------------------------------
# Retirer alors --certfile/--keyfile de l'ExecStart, et décommenter :
#
# TRUST_PROXY=1
# BASE_URL=https://sort.mondomaine.fr

# --- Test local en HTTP uniquement -------------------------------------------
# Sans TLS, le cookie de session ne peut pas porter le flag Secure, sinon la
# connexion boucle. À ne jamais activer sur une instance exposée.
#
# ALLOW_INSECURE=1

# --- Clé de session ----------------------------------------------------------

# Sinon générée dans secrets/secret. La fixer évite de déconnecter tout le monde
# si ce fichier disparaît.   openssl rand -hex 32
FLASK_SECRET_KEY=
