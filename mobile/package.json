{
  "name": "spotify-sort-mobile",
  "version": "0.5.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc --outDir dist --rootDir . --module commonjs --moduleResolution node --target es2022 --skipLibCheck --noEmit false lib/api.ts",
    "test": "node --test 'tests/**/*.test.js'",
    "build:apk": "eas build --platform android --profile preview",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-share-intent": "^5.1.1",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  }
}
